```{=html}
<div class="list blog-listing">
<% for (const post of items) { %>
  <div class="va-post" <%= metadataAttrs(post) %>>
    <span class="va-postdate"><%= post.date %></span>
    <div>
      <h3 class="va-posttitle"><a href="<%- post.path %>"><%= post.title %></a></h3>
      <% if (post.description) { %>
      <div class="va-postdesc"><%= post.description %></div>
      <% } %>
      <% // Category chips: Quarto's listing script (1.4+) expects the category
         // as base64 of its URI-encoded name, which utils.b64encode produces (it
         // is what Quarto's own templates pass). A plain name makes
         // quartoListingCategory() throw, so the click silently does nothing. %>
      <% if (post.categories && post.categories.length) { %>
      <div class="va-pubtags">
        <% for (const tag of post.categories) { %>
        <span class="va-pubtag listing-category" onclick="window.quartoListingCategory && window.quartoListingCategory('<%= utils.b64encode(tag) %>'); return false;"><%= tag %></span>
        <% } %>
      </div>
      <% } %>
    </div>
    <div class="va-postmeta">
      <% if (post['reading-time']) { %>
      <span class="va-postmins"><%= post['reading-time'] %> read</span>
      <% } %>
    </div>
  </div>
<% } %>
</div>
```
